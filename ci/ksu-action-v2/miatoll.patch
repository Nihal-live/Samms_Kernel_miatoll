diff --git a/config/miatoll.env b/config/miatoll.env
new file mode 100644
index 0000000..66e290b
--- /dev/null
+++ b/config/miatoll.env
@@ -0,0 +1,107 @@
+# Build profile: Xiaomi Redmi Note 9 Pro / Poco M2 Pro (miatoll), SKYNET kernel.
+#
+#   Linux 4.14.357-openela, Clang + LLD, CONFIG_LOCALVERSION=-SKYNET
+#   SukiSU-Nova (builtin, pinned) integrated by the kernel tree itself
+#   KPM on, which means the image gets a KernelPatch post-build step
+#   No SUSFS (the tree does not ship it and it is not wanted here)
+#
+# Pick this file in "Config file to build" when starting a build.
+
+CONFIG_ENV=config/miatoll.env
+
+# ============================================================ Kernel source ==
+
+KERNEL_SOURCE=https://github.com/Nihal-live/Samms_Kernel_miatoll
+# Branch, not a tag: the KPM/cpu_spoof work is on it. Pin a commit if you want
+# a frozen build.
+KERNEL_SOURCE_BRANCH=arena/6930beb9-samms-kernel-miatoll
+KERNEL_CONFIG=vendor/xiaomi/miatoll_defconfig
+KERNEL_IMAGE_NAME=Image.gz-dtb
+ARCH=arm64
+
+KERNEL_NAME=miatoll
+ADD_LOCALVERSION_TO_FILENAME=true
+
+# LTO means Clang must also link and archive: lld and the LLVM binutils, not
+# the AOSP GCC ones. The tree's Makefile refuses to build when CROSS_COMPILE
+# ends in android- unless CLANG_TRIPLE names the real target triple, which is
+# why that goes in CUSTOM_CMDS. CONFIG_LLVM_POLLY has to go as well: the
+# prebuilt Clang has no Polly and the defconfig turns it on for LTO.
+#
+# HOSTLDFLAGS=-B/usr/bin is not cosmetic. proton-clang's bin/ contains an old
+# GNU ld (the NDK one), and the toolchain's directory is in PATH, so the host
+# link of scripts/basic/fixdep picks it up and dies on a modern glibc:
+#
+#   .../clang/bin/ld: /usr/lib/x86_64-linux-gnu/libc.so.6: unknown type [0x13]
+#   section '.relr.dyn'  ->  collect2: error: ld returned 1 exit status
+#   make[2]: *** [scripts/Makefile.host:102: scripts/basic/fixdep] Error 1
+#
+# -B/usr/bin points the host compiler at the system binutils for that link,
+# before the defconfig stage needs fixdep.
+CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-
+EXTRA_CMDS:LD=ld.lld AR=llvm-ar NM=llvm-nm OBJCOPY=llvm-objcopy OBJDUMP=llvm-objdump STRIP=llvm-strip HOSTLDFLAGS=-B/usr/bin
+
+# =================================================================== Clang ===
+#
+# Same toolchain the tree's own workflow uses and that has produced working
+# images for it. AOSP r450784e also works but is much older than this tree's
+# LTO setup; if you switch, expect new warnings on 4.14 vendor code.
+CLANG_BRANCH=master
+CLANG_VERSION=
+USE_CUSTOM_CLANG=true
+CUSTOM_CLANG_SOURCE=https://github.com/kdrag0n/proton-clang.git
+CUSTOM_CLANG_BRANCH=master
+
+USE_LLVM=false
+ENABLE_GCC_ARM64=true
+ENABLE_GCC_ARM32=true
+
+# =============================================================== KernelSU ===
+#
+# samms-nova = SukiSU-Nova 'builtin', installed by the kernel tree's own
+# scripts/ksu-nova-setup.sh. That script owns the 4.14 hook call sites, the
+# KPM and cpu_spoof ports and the defconfig block, so KSU_HOOK_MODE is 'none':
+# anything else would patch the hooks a second time.
+KSU_VARIANT=samms-nova
+KSU_REF=4bec532dd447e2852aa8932afa768255350c103a
+KSU_HOOK_MODE=none
+
+# =================================================================== SUSFS ===
+
+ENABLE_SUSFS=false
+
+# ========================================================== Extra patches ===
+
+# SukiSU-Nova already has its own path_umount() shim for < 5.9; applying the
+# backport again would define it twice.
+ENABLE_PATH_UMOUNT=false
+ENABLE_HIDE_STUFF=false
+
+# Kernel Patch Module support. The kernel side is SukiSU's bridge
+# (CONFIG_KPM=y); the loader is KernelPatch, injected into the built image by
+# scripts/kpm-patch.sh. Only arm64.
+ENABLE_KPM=true
+
+# ================================================================ Kconfig ===
+
+ADD_KPROBES_CONFIG=false
+ADD_OVERLAYFS_CONFIG=true
+DISABLE_LTO=false
+DISABLE_CC_WERROR=false
+
+# Applied to the defconfig after the KernelSU block. Polly off: see above.
+EXTRA_DEFCONFIG=CONFIG_LLVM_POLLY=n
+
+# ============================================================= AnyKernel3 ===
+
+USE_CUSTOM_ANYKERNEL3=false
+
+# ============================================================== Packaging ===
+
+NEED_DTBO=false
+BUILD_BOOT_IMG=false
+
+# ================================================================= Runner ===
+
+ENABLE_CCACHE=true
+REMOVE_UNUSED_PACKAGES=true
