diff --git a/scripts/patches.sh b/scripts/patches.sh
index eade6bf..670734c 100644
--- a/scripts/patches.sh
+++ b/scripts/patches.sh
@@ -345,6 +345,20 @@ hooks_patch_apply() {
 kpm_patch_image() {
 	local image=$1
 	group "Applying KPM (patch_linux)"
+
+	# Trees that carry their own KPM step own the gzip+dtb repacking too.
+	# Duplicating that here would mean two copies of the payload arithmetic
+	# drifting apart, and the tree's copy verifies the result.
+	if [ -x "${KERNEL_DIR}/scripts/kpm-patch.sh" ]; then
+		info "delegating to the kernel tree's scripts/kpm-patch.sh"
+		( cd "$KERNEL_DIR" && OUT_DIR="${KERNEL_DIR}/out" ./scripts/kpm-patch.sh ) \
+			|| die "scripts/kpm-patch.sh failed"
+		ok "KernelPatch injected by the in-tree script"
+		summary "| KPM | applied (in-tree patch script) |"
+		endgroup
+		return 0
+	fi
+
 	local dir tool
 	dir=$(sukisu_patch_dir)
 	tool="${dir}/kpm/patch_linux"
