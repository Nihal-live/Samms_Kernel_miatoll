-			_err "ENABLE_KPM is only supported with KSU_VARIANT=sukisu-ultra (got '${CFG[KSU_VARIANT]}')"
+		case "${CFG[KSU_VARIANT]}" in
+			sukisu-ultra | samms-nova) ;;
+			*) _err "ENABLE_KPM is only supported with KSU_VARIANT=sukisu-ultra or samms-nova (got '${CFG[KSU_VARIANT]}')" ;;
+		esac
 		[ "${CFG[ARCH]}" = "arm64" ] ||
 			_err "ENABLE_KPM requires ARCH=arm64"
 	fi
diff --git a/scripts/kernelsu.sh b/scripts/kernelsu.sh
index 6ed0170..214b6ca 100644
--- a/scripts/kernelsu.sh
+++ b/scripts/kernelsu.sh
@@ -60,6 +60,14 @@ ksu_registry() {
 		echo "https://github.com/rsuntk/KernelSU|main|KernelSU|main|main|susfs-rksu-master|RKSU (rsuntk)" ;;
 	backslashxx)
 		echo "https://github.com/backslashxx/KernelSU|master|KernelSU|master|master|-|backslashxx KernelSU" ;;
+	samms-nova)
+		# SukiSU-Nova 'builtin' tree, integrated by the kernel tree itself:
+		# scripts/ksu-nova-setup.sh in the source repo owns the 4.14 hook call
+		# sites, the KPM and cpu_spoof ports and the defconfig block. A '-'
+		# repo means "the tree installs it" -- there is no kernel/setup.sh to
+		# fetch for this ref, and re-deriving the hook layout here would undo
+		# exactly the work that makes it link on 4.14.
+		echo "-|builtin|KernelSU|4bec532dd447e2852aa8932afa768255350c103a|4bec532dd447e2852aa8932afa768255350c103a|-|SukiSU-Nova (in-tree)" ;;
 	*)
 		die "unknown KSU_VARIANT '$1'" ;;
 	esac
@@ -82,6 +90,12 @@ ksu_install() {
 	local repo setup_ref dir modern_ref legacy_ref susfs_refs name
 	IFS='|' read -r repo setup_ref dir modern_ref legacy_ref susfs_refs name <<<"$(ksu_registry "$variant")"
 
+	if [ "$repo" = "-" ]; then
+		ksu_install_in_tree "$variant" "$dir" "$name" \
+			"${requested_ref:-$legacy_ref}"
+		return 0
+	fi
+
 	group "Installing ${name}"
 	info "repository: ${repo}"
 
@@ -193,6 +207,76 @@ ksu_install() {
 	endgroup
 }
 
+# ------------------------------------------------- in-tree integration ---
+#
+# Some forks ship no setup.sh: the kernel tree itself carries the integration
+# (source-level hooks, ports for the kernel version, defconfig block). Running
+# the generic installer on top of that would be wrong twice over -- there is
+# nothing to fetch, and re-patching hooks that the tree already owns can land
+# them twice. So this path only *runs the tree's script* and then verifies what
+# it produced with the same checks the generic path uses.
+
+ksu_install_in_tree() {
+	local variant=$1 dir=$2 name=$3 ref=$4
+	local script="${KERNEL_DIR}/scripts/ksu-nova-setup.sh"
+
+	group "Installing ${name}"
+	[ -f "$script" ] || die "${variant} installs from the kernel tree, but
+       ${KERNEL_DIR}/scripts/ksu-nova-setup.sh does not exist.
+       Point KERNEL_SOURCE at the repo that carries it, or use a variant that
+       ships its own setup.sh."
+	info "running the in-tree integration: scripts/ksu-nova-setup.sh"
+
+	local kver
+	kver=$(kernel_version "$KERNEL_DIR" || echo "0.0")
+	info "kernel ${kver}; the in-tree script refuses anything but the version"
+	info "it was written for, so a mismatch fails here instead of at link time"
+
+	( cd "$KERNEL_DIR" && KSU_REF="$ref" bash scripts/ksu-nova-setup.sh ) \
+		|| die "${name} in-tree integration failed -- see its output above"
+
+	# --- verify what it claims to have done ---------------------------------
+	local ksu_dir="${KERNEL_DIR}/${dir}"
+	[ -d "$ksu_dir" ] || die "integration finished but ${dir}/ is missing"
+	[ -e "${KERNEL_DIR}/drivers/kernelsu" ] \
+		|| die "drivers/kernelsu symlink was not created"
+	grep -qE '^[[:space:]]*obj-\$\(CONFIG_KSU\)[[:space:]]*\+=[[:space:]]*kernelsu/?[[:space:]]*$' \
+		"${KERNEL_DIR}/drivers/Makefile" \
+		|| die "drivers/Makefile was not wired to CONFIG_KSU for kernelsu"
+	grep -q 'drivers/kernelsu/Kconfig' "${KERNEL_DIR}/drivers/Kconfig" \
+		|| die "drivers/Kconfig was not wired up for kernelsu"
+
+	local head_sha head_desc
+	head_sha=$(git -C "$ksu_dir" rev-parse --short HEAD)
+	head_desc=$(git -C "$ksu_dir" describe --tags --always 2>/dev/null || echo "$head_sha")
+	if [ -n "$ref" ]; then
+		local want
+		want=$(git -C "$ksu_dir" rev-parse --verify --quiet "${ref}^{commit}" 2>/dev/null || true)
+		if [ -n "$want" ] && [ "$want" != "$(git -C "$ksu_dir" rev-parse HEAD)" ]; then
+			die "${name} is checked out at ${head_desc}, not the requested ref '${ref}'"
+		fi
+	fi
+	ok "${name} installed at ${head_desc} (${head_sha})"
+
+	# The tree owns the hook call sites; nothing here may patch them again.
+	export_env KSU_HOOK_MODE none
+	export_env KSU_HOOK_MODE_RESOLVED none
+	info "hook mode: none (the in-tree script patches the call sites itself)"
+
+	export_env KSU_DIR "$dir"
+	export_env KSU_NAME "$name"
+	export_env KSU_REF_RESOLVED "${ref:-<tree default>}"
+	export_env KSU_VERSION_LABEL "${ref:-HEAD}-${head_sha}"
+	export_env KSU_SUSFS_BUNDLED_REFS "-"
+	export_env UPLOADNAME "-${name// /_}_${head_sha}"
+
+	summary "| KernelSU variant | \`${name}\` |"
+	summary "| KernelSU ref | \`${ref:-tree default}\` -> \`${head_sha}\` |"
+	summary "| Hooks | patched by the kernel tree |"
+
+	endgroup
+}
+
